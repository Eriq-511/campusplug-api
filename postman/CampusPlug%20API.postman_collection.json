    {
      "name": "Listings",
      "description": "Listing CRUD + state actions. Every state-change request has a test script that asserts the returned status and actions flags.",
      "item": [
        {
          "name": "Create Listing (sets {{listingId}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "if (j && j.id) { pm.environment.set('listingId', j.id); }",
                  "pm.test('status is ACTIVE', () => pm.expect(j.status).to.eql('ACTIVE'));",
                  "pm.test('actions.canEdit true', () => pm.expect(j.actions.canEdit).to.be.true);",
                  "pm.test('actions.canMarkSold true', () => pm.expect(j.actions.canMarkSold).to.be.true);",
                  "pm.test('actions.canDelete true', () => pm.expect(j.actions.canDelete).to.be.true);",
                  "pm.test('actions.canRestore false', () => pm.expect(j.actions.canRestore).to.be.false);",
                  "pm.test('actions.canPurge false', () => pm.expect(j.actions.canPurge).to.be.false);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Laptop\",\n  \"priceUgx\": 1000000,\n  \"categoryCode\": \"ELECTRONICS\",\n  \"description\": \"Good condition\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/listings"
          }
        },
        {
          "name": "My Listings — All",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/listings/my?status=ALL"
          }
        },
        {
          "name": "My Listings — Active",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/listings/my?status=ACTIVE"
          }
        },
        {
          "name": "My Listings — Sold",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/listings/my?status=SOLD"
          }
        },
        {
          "name": "My Listings — Deleted",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/listings/my?status=DELETED"
          }
        },
        {
          "name": "Update Listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status still ACTIVE', () => pm.expect(j.status).to.eql('ACTIVE'));",
                  "pm.test('actions.canEdit true', () => pm.expect(j.actions.canEdit).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"priceUgx\": 1200000,\n  \"categoryCode\": \"ELECTRONICS\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}"
          }
        },
        {
          "name": "Attach Listing Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.images && j.images.length > 0) {",
                  "  const last = j.images[j.images.length - 1];",
                  "  pm.environment.set('imageId', last.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicId\": \"example-public-id\",\n  \"secureUrl\": \"https://res.cloudinary.com/demo/image/upload/example-public-id.jpg\",\n  \"width\": 800,\n  \"height\": 600,\n  \"bytes\": 12345,\n  \"format\": \"jpg\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}/images"
          }
        },
        {
          "name": "Remove Listing Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}/images/{{imageId}}"
          }
        },
        {
          "name": "Mark Listing SOLD",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status is SOLD', () => pm.expect(j.status).to.eql('SOLD'));",
                  "pm.test('actions.canEdit false (SOLD = terminal)', () => pm.expect(j.actions.canEdit).to.be.false);",
                  "pm.test('actions.canMarkSold false', () => pm.expect(j.actions.canMarkSold).to.be.false);",
                  "pm.test('actions.canDelete false', () => pm.expect(j.actions.canDelete).to.be.false);",
                  "pm.test('actions.canRestore false', () => pm.expect(j.actions.canRestore).to.be.false);",
                  "pm.test('actions.canPurge false', () => pm.expect(j.actions.canPurge).to.be.false);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}/sold"
          }
        },
        {
          "name": "Soft Delete Listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status is DELETED', () => pm.expect(j.status).to.eql('DELETED'));",
                  "pm.test('actions.canEdit false', () => pm.expect(j.actions.canEdit).to.be.false);",
                  "pm.test('actions.canMarkSold false', () => pm.expect(j.actions.canMarkSold).to.be.false);",
                  "pm.test('actions.canDelete false', () => pm.expect(j.actions.canDelete).to.be.false);",
                  "pm.test('actions.canRestore true', () => pm.expect(j.actions.canRestore).to.be.true);",
                  "pm.test('actions.canPurge true', () => pm.expect(j.actions.canPurge).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}/delete"
          }
        },
        {
          "name": "Restore Listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status is ACTIVE', () => pm.expect(j.status).to.eql('ACTIVE'));",
                  "pm.test('actions.canEdit true', () => pm.expect(j.actions.canEdit).to.be.true);",
                  "pm.test('actions.canMarkSold true', () => pm.expect(j.actions.canMarkSold).to.be.true);",
                  "pm.test('actions.canDelete true', () => pm.expect(j.actions.canDelete).to.be.true);",
                  "pm.test('actions.canRestore false', () => pm.expect(j.actions.canRestore).to.be.false);",
                  "pm.test('actions.canPurge false', () => pm.expect(j.actions.canPurge).to.be.false);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}/restore"
          }
        },
        {
          "name": "Purge Listing (hard delete — must be DELETED first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}/purge"
          }
        }
      ]
    },
    {
      "name": "Listing Lifecycle (state machine demo)",
      "description": "Runs the full state machine in order. Uses {{token}} so log in first. Each step asserts status + actions in the response.",
      "item": [
        {
          "name": "LC1 — Create (→ ACTIVE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "if (j && j.id) { pm.environment.set('lcListingId', j.id); }",
                  "pm.test('status ACTIVE', () => pm.expect(j.status).to.eql('ACTIVE'));",
                  "pm.test('canEdit true', () => pm.expect(j.actions.canEdit).to.be.true);",
                  "pm.test('canMarkSold true', () => pm.expect(j.actions.canMarkSold).to.be.true);",
                  "pm.test('canDelete true', () => pm.expect(j.actions.canDelete).to.be.true);",
                  "pm.test('canRestore false', () => pm.expect(j.actions.canRestore).to.be.false);",
                  "pm.test('canPurge false', () => pm.expect(j.actions.canPurge).to.be.false);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"LC Test Item\",\n  \"priceUgx\": 50000,\n  \"categoryCode\": \"ELECTRONICS\",\n  \"description\": \"Lifecycle demo\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/listings"
          }
        },
        {
          "name": "LC2 — Delete (ACTIVE → DELETED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status DELETED', () => pm.expect(j.status).to.eql('DELETED'));",
                  "pm.test('canEdit false', () => pm.expect(j.actions.canEdit).to.be.false);",
                  "pm.test('canDelete false', () => pm.expect(j.actions.canDelete).to.be.false);",
                  "pm.test('canRestore true', () => pm.expect(j.actions.canRestore).to.be.true);",
                  "pm.test('canPurge true', () => pm.expect(j.actions.canPurge).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/listings/{{lcListingId}}/delete"
          }
        },
        {
          "name": "LC3 — Restore (DELETED → ACTIVE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status ACTIVE', () => pm.expect(j.status).to.eql('ACTIVE'));",
                  "pm.test('canEdit true', () => pm.expect(j.actions.canEdit).to.be.true);",
                  "pm.test('canDelete true', () => pm.expect(j.actions.canDelete).to.be.true);",
                  "pm.test('canRestore false', () => pm.expect(j.actions.canRestore).to.be.false);",
                  "pm.test('canPurge false', () => pm.expect(j.actions.canPurge).to.be.false);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/listings/{{lcListingId}}/restore"
          }
        },
        {
          "name": "LC4 — Mark SOLD (ACTIVE → SOLD)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status SOLD', () => pm.expect(j.status).to.eql('SOLD'));",
                  "pm.test('canEdit false (terminal)', () => pm.expect(j.actions.canEdit).to.be.false);",
                  "pm.test('canMarkSold false', () => pm.expect(j.actions.canMarkSold).to.be.false);",
                  "pm.test('canDelete false', () => pm.expect(j.actions.canDelete).to.be.false);",
                  "pm.test('canRestore false', () => pm.expect(j.actions.canRestore).to.be.false);",
                  "pm.test('canPurge false', () => pm.expect(j.actions.canPurge).to.be.false);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/listings/{{lcListingId}}/sold"
          }
        },
        {
          "name": "LC5 — Create second listing for purge path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.id) { pm.environment.set('lcListingId2', j.id); }",
                  "pm.test('status ACTIVE', () => pm.expect(j.status).to.eql('ACTIVE'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"LC Purge Test Item\",\n  \"priceUgx\": 10000,\n  \"categoryCode\": \"BOOKS\",\n  \"description\": \"Will be purged\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/listings"
          }
        },
        {
          "name": "LC6 — Delete second listing (ACTIVE → DELETED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('status DELETED', () => pm.expect(j.status).to.eql('DELETED'));",
                  "pm.test('canPurge true', () => pm.expect(j.actions.canPurge).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/listings/{{lcListingId2}}/delete"
          }
        },
        {
          "name": "LC7 — Purge (DELETED → gone, 204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/listings/{{lcListingId2}}/purge"
          }
        }
      ]
    },
    {
      "name": "Browse",
      "item": [
        {
          "name": "Search Listings",
          "request": {
