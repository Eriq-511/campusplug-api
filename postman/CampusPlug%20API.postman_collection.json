        {
          "name": "Login (sets {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.token) { pm.environment.set('token', json.token); }",
                  "if (json && json.user && json.user.email) { pm.environment.set('email', json.user.email); }",
                  "if (json && json.user && json.user.id) { pm.environment.set('userId', json.user.id); pm.environment.set('publicUserId', json.user.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
