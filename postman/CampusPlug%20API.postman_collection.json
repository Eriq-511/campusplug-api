    {
      "name": "Conversation Flow (2-user demo)",
      "description": "Step-by-step: Poster creates listing, Inquirer starts conversation, both exchange messages. Run in order.",
      "item": [
        {
          "name": "Step 1 — Register Poster",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const j = pm.response.json(); if (j && j.token) { pm.environment.set('sellerToken', j.token); pm.environment.set('token', j.token); } "],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alice Seller\",\n  \"registrationNumber\": \"2025/BIT/001\",\n  \"email\": \"alice.seller@std.must.ac.ug\",\n  \"phoneNumber\": \"+256700000001\",\n  \"campus\": \"main\",\n  \"registeredLocation\": { \"label\": \"MUST Main Campus\", \"lat\": -0.6089, \"lng\": 30.6570 },\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Step 2 — Register Inquirer",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const j = pm.response.json(); if (j && j.token) { pm.environment.set('buyerToken', j.token); } "],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Bob Buyer\",\n  \"registrationNumber\": \"2025/BIT/002\",\n  \"email\": \"bob.buyer@std.must.ac.ug\",\n  \"phoneNumber\": \"+256700000002\",\n  \"campus\": \"main\",\n  \"registeredLocation\": { \"label\": \"MUST Main Campus\", \"lat\": -0.6089, \"lng\": 30.6570 },\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Step 3 — Login as Poster (sets sellerToken + token)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const j = pm.response.json(); if (j && j.token) { pm.environment.set('sellerToken', j.token); pm.environment.set('token', j.token); }"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice.seller@std.must.ac.ug\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Step 4 — Create Listing as Poster (sets listingId)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const j = pm.response.json(); if (j && j.id) { pm.environment.set('listingId', j.id); }"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"MacBook Pro 2021\",\n  \"priceUgx\": 4500000,\n  \"categoryCode\": \"ELECTRONICS\",\n  \"description\": \"Great condition, barely used\"\n}" },
            "url": "{{baseUrl}}/api/v1/listings"
          }
        },
        {
          "name": "Step 5 — Login as Inquirer (sets buyerToken + token)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const j = pm.response.json(); if (j && j.token) { pm.environment.set('buyerToken', j.token); pm.environment.set('token', j.token); }"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"bob.buyer@std.must.ac.ug\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Step 6 — Inquirer starts Conversation (sets conversationId)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const j = pm.response.json(); if (j && j.id) { pm.environment.set('conversationId', j.id); }"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"listingId\": {{listingId}}\n}" },
            "url": "{{baseUrl}}/api/v1/conversations"
          }
        },
        {
          "name": "Step 7 — Inquirer sends Message (sets messageId)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["const j = pm.response.json(); if (j && j.id) { pm.environment.set('messageId', j.id); }"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"body\": \"Hi, is this still available?\"\n}" },
            "url": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages"
          }
        },
        {
          "name": "Step 8 — Poster replies",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"body\": \"Yes, still available! When can you come?\"\n}" },
            "url": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages"
          }
        },
        {
          "name": "Step 9 — Poster reads messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "url": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages?limit=50"
          }
        }
      ]
    },
